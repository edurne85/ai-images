{
    "name": "ai-images",
    "version": "0.0.1",
    "license": "MIT",
    "description": "An Electron application with React and TypeScript",
    "main": "./out/main/index.js",
    "author": "Edurne Pascual Sáez",
    "homepage": "https://github.com/edurne85/ai-images",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint --cache .",
        "lint:fix": "eslint --cache --fix .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "check:fix": "npm run lint:fix && npm run format && npm run typecheck",
        "check:quick": "npm run lint && npm run format:check && npm run typecheck",
        "check:full": "npm run lint && npm run format:check && npm run typecheck && npm run build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "electron-updater": "^6.3.9",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.1",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.5.0",
        "@mui/styled-engine-sc": "^9.5.0",
        "@mui/system": "9.5.0",
        "@mui/x-data-grid": "^9.17.0",
        "@mui/x-date-pickers": "^9.17.0",
        "@mui/x-tree-view": "^9.17.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "dayjs": "^1.11.23",
        "electron": "^41.10.7",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "styled-components": "^6.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.7"
    }
}
